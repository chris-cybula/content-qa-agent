{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
