# API settings template
# Copy to api/.env (git-ignored). Never commit a real key. Paid calls stop at CLAUDE_MONTHLY_BUDGET_USD.
# ALLOW_PRIVATE_ADDRESSES=true lets the crawler reach the local demo site; leave it out on a server.

ANTHROPIC_API_KEY=
CLAUDE_MONTHLY_BUDGET_USD=3
CLAUDE_MAX_TOKENS_LIMIT=8192
CLAUDE_REQUESTS_PER_MINUTE=10
CLAUDE_TIMEOUT_SECONDS=120
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_CONTEXT_TOKENS=8192
DATABASE_URL=postgresql+asyncpg://qa:qa@localhost:5432/content_qa
MAX_PAGES=50
HTTP_TIMEOUT_SECONDS=10
CRAWL_CONCURRENCY=4
CHECK_EXTERNAL_LINKS=false
ALLOW_PRIVATE_ADDRESSES=true
API_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_OTEL_URL=https://cloud.langfuse.com/api/public/otel
LANGFUSE_TRACE_CONTENT=true
BRAND_GUIDE_FILE=../demo-site/brand-guide.md
